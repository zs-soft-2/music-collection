# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
dist
tmp
/out-tsc

# dependencies
node_modules

# secrets — the functions emulator reads apps/functions/.secret.local, and the
# real values live in Secret Manager, never in the repo
.secret.local
.env
.env.local

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.angular

/.firebase/*.*
/emulators.backup
/firebase-debug.log
/ui-debug.log
/firestore-debug.log

/.nx
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
# Discogs import cache
/tools/discogs/.cache

# OpenTofu
.terraform/
# A riasztások e-mail címei. A repó publikus, cím nem kerülhet bele; a tofu
# ezt a fájlt magától beolvassa a környezeti gyökérből.
infra/environments/*/local.auto.tfvars
# Mentett tofu plan: egy futáshoz készül, és a state-tel együtt avul el.
*.tfplan
*.tfstate
*.tfstate.*
.zs-cloud-progress.json

# Generated build version (tools/version/generate-version.mjs)
/apps/music-collection/src/environments/version.ts

# Generated App Check debug token (tools/app-check/generate-debug-token.mjs),
# and the file it reads — the token is a secret, this repo is public
/apps/music-collection/src/environments/app-check-debug-token.ts
/.app-check-debug-token

# Generated PrimeUI license key (tools/primeui/generate-license.mjs), and the
# file it reads — the key is tied to the developer who claimed it, this repo
# is public
/apps/music-collection/src/environments/primeui-license.ts
/.primeui-license
