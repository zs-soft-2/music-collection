{
	"name": "domain-document",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "libs/domain/document/src",
	"prefix": "music-collection",
	"tags": ["type:domain", "platform:angular"],
	"targets": {
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "libs/domain/document/jest.config.ts",
				"passWithNoTests": true,
				"tsConfig": "libs/domain/document/tsconfig.spec.json"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"options": {
				"lintFilePatterns": [
					"libs/domain/document/**/*.ts",
					"libs/domain/document/**/*.html"
				]
			}
		}
	}
}
