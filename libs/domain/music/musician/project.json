{
	"name": "domain-musician",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"sourceRoot": "libs/domain/music/musician/src",
	"prefix": "music-collection",
	"tags": [],
	"targets": {
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "libs/domain/music/musician/jest.config.ts",
				"passWithNoTests": true,
				"tsConfig": "libs/domain/music/musician/tsconfig.spec.json"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"options": {
				"lintFilePatterns": [
					"libs/domain/music/musician/**/*.ts",
					"libs/domain/music/musician/**/*.html"
				]
			}
		}
	}
}
