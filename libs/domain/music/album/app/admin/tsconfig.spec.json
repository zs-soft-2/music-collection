{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../../../../../dist/out-tsc",
		"module": "preserve",
		"target": "es2016",
		"types": ["jest", "node"],
		"moduleResolution": "bundler",
		"isolatedModules": true,
		// A teszt-provider a valódi szótárat olvassa be.
		"resolveJsonModule": true
	},
	"files": ["src/test-setup.ts"],
	"include": [
		"jest.config.ts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/*.d.ts"
	]
}
