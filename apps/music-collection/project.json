{
	"name": "music-collection",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/music-collection/src",
	"prefix": "music-collection",
	"tags": ["type:app", "platform:angular"],
	"targets": {
		"version": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "node tools/version/generate-version.mjs"
			}
		},
		"app-check-token": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "node tools/app-check/generate-debug-token.mjs"
			}
		},
		"build": {
			"executor": "@angular-devkit/build-angular:browser",
			"outputs": [
				"{options.outputPath}"
			],
			"options": {
				"allowedCommonJsDependencies": [
					"deepmerge",
					"file-saver",
					"object-hash"
				],
				"outputPath": "dist/apps/music-collection",
				"index": "apps/music-collection/src/index.html",
				"main": "apps/music-collection/src/main.ts",
				"tsConfig": "apps/music-collection/tsconfig.app.json",
				"webWorkerTsConfig": "apps/music-collection/tsconfig.worker.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					"apps/music-collection/src/favicon.ico",
					"apps/music-collection/src/favicon.svg",
					"apps/music-collection/src/assets",
					{
						"glob": "countries-110m.json",
						"input": "node_modules/world-atlas",
						"output": "assets/world"
					}
				],
				"styles": [
					"node_modules/primeicons/primeicons.css",
					"node_modules/primeflex/primeflex.css",
					"apps/music-collection/src/styles.scss"
				],
				"scripts": []
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "1.5mb",
							"maximumError": "4.5mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "8kb",
							"maximumError": "16kb"
						}
					],
					"fileReplacements": [
						{
							"replace": "apps/music-collection/src/environments/environment.ts",
							"with": "apps/music-collection/src/environments/environment.prod.ts"
						}
					],
					"outputHashing": "all"
				},
				"dev": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "1.5mb",
							"maximumError": "4.5mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "8kb",
							"maximumError": "16kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"buildOptimizer": false,
					"optimization": false,
					"vendorChunk": true,
					"extractLicenses": false,
					"sourceMap": true,
					"namedChunks": true
				}
			},
			"defaultConfiguration": "dev",
			"dependsOn": [
				"^build",
				"version",
				"app-check-token"
			],
			"inputs": [
				"production",
				"^production",
				{
					"env": "GITHUB_RUN_NUMBER"
				},
				{
					"env": "GITHUB_SHA"
				},
				{
					"env": "MC_APP_CHECK_DEBUG_TOKEN"
				}
			]
		},
		"serve": {
			"executor": "@angular-devkit/build-angular:dev-server",
			"options": {
				"host": "127.0.0.1"
			},
			"configurations": {
				"production": {
					"buildTarget": "music-collection:build:production"
				},
				"development": {
					"buildTarget": "music-collection:build:development"
				}
			},
			"defaultConfiguration": "development",
			"continuous": true,
			"dependsOn": [
				"version",
				"app-check-token"
			]
		},
		"extract-i18n": {
			"executor": "@angular-devkit/build-angular:extract-i18n",
			"options": {
				"buildTarget": "music-collection:build"
			}
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "apps/music-collection/jest.config.ts",
				"tsConfig": "apps/music-collection/tsconfig.spec.json"
			},
			"dependsOn": [
				"version",
				"app-check-token"
			]
		},
		"lint": {
			"executor": "@nx/eslint:lint"
		},
		"serve-static": {
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "angular-monorepo:build",
				"port": 4200,
				"spa": true
			}
		}
	}
}
