{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "node16",
		"moduleResolution": "node16",
		"rootDir": "src",
		"outDir": "lib",
		"types": ["node"],
		"strict": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.spec.ts"]
}
