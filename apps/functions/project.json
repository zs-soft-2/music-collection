{
	"name": "functions",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/functions/src",
	"tags": ["type:app", "platform:agnostic"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"outputs": ["{projectRoot}/lib"],
			"options": {
				"command": "tsc --project tsconfig.app.json",
				"cwd": "apps/functions"
			}
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "apps/functions/jest.config.ts",
				"passWithNoTests": true,
				"tsConfig": "apps/functions/tsconfig.spec.json"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"options": {
				"lintFilePatterns": ["apps/functions/**/*.ts"]
			}
		}
	}
}
