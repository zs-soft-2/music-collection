{
	"name": "firestore-rules",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/firestore-rules/src",
	"tags": ["type:app", "platform:agnostic"],
	"targets": {
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "firebase emulators:exec --project demo-music-collection --only firestore \"npx jest --config apps/firestore-rules/jest.config.ts\"",
				"cwd": "{workspaceRoot}",
				"forwardAllArgs": false
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"options": {
				"lintFilePatterns": ["apps/firestore-rules/**/*.ts"]
			}
		}
	}
}
