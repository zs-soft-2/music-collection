{
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"hosting": [
		{
			"target": "app",
			"public": "dist/apps/music-collection",
			"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		}
	],
	"emulators": {
		"auth": {
			"port": 9199
		},
		"firestore": {
			"port": 9198
		},
		"hosting": {
			"port": 9197
		},
		"storage": {
			"port": 9195
		},
		"ui": {
			"enabled": true
		},
		"singleProjectMode": true
	},
	"storage": [
		{
			"target": "main",
			"rules": "storage.rules"
		}
	]
}
