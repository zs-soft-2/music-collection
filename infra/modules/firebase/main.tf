# Generated by `zs workspace create` / `zs cloud`, adapted for music-collection.
# Firebase resources require the google-beta provider.
terraform {
  required_providers {
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
  }
}

variable "project_id" { type = string }
variable "hosting_sites" {
  type    = list(string)
  default = []
}
variable "web_app_display_name" {
  type    = string
  default = "music-collection"
}
variable "firestore_location" {
  type        = string
  description = "A Firestore adatbázis helye. Létrehozás után NEM módosítható; a dev a prod helyét követi."
}

resource "google_firebase_project" "this" {
  provider = google-beta
  project  = var.project_id
}

resource "google_firebase_hosting_site" "sites" {
  provider = google-beta
  for_each = toset(var.hosting_sites)
  project  = var.project_id
  site_id  = each.value

  depends_on = [google_firebase_project.this]
}

# Az app ennek a web-SDK konfigurációját kapja (`environment*.ts`).
resource "google_firebase_web_app" "app" {
  provider     = google-beta
  project      = var.project_id
  display_name = var.web_app_display_name

  # ABANDON: a web app törlése minden kliens hitelesítését eltörné — tofu-ból sosem.
  deletion_policy = "ABANDON"

  depends_on = [google_firebase_project.this]
}

resource "google_firestore_database" "default" {
  provider    = google-beta
  project     = var.project_id
  name        = "(default)"
  location_id = var.firestore_location
  type        = "FIRESTORE_NATIVE"

  # ABANDON: egy destroy a state-ből veszi ki, az adatot nem érinti.
  deletion_policy = "ABANDON"

  depends_on = [google_firebase_project.this]
}

output "web_app_id" {
  value = google_firebase_web_app.app.app_id
}
