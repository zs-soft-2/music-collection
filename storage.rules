rules_version = '2';

// ---------------------------------------------------------------------------
// Music Collection — Cloud Storage security rules.
//
// Permission-alapú, a firestore.rules-szal azonos permission-nevekkel és
// ugyanabból az egy igazságforrásból: a `security/users/{uid}/
// effective_permissions` dokumentumot cross-service `firestore.get()`-tel
// olvassuk. Custom claimet nem használunk — a claimek együtt 1000 bájtba
// férnek, amit a teljes permission-lista túllépné.
//
// A dokumentumot a jogosultság-szinkron function tartja karban
// (`apps/functions`). Feltételei: a Firestore az alapértelmezett
// (`(default)`) adatbázis, és minden ellenőrzés egy Firestore-olvasást jelent.
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function effectivePermissionsPath() {
      return /databases/(default)/documents/security/users/$(request.auth.uid)/effective_permissions;
    }
    function permissions() {
      return firestore.get(effectivePermissionsPath()).data.permissions;
    }
    function hasPerm(perm) {
      return request.auth != null
          && firestore.exists(effectivePermissionsPath())
          && permissions() is list
          && (perm in permissions() || 'ADMIN' in permissions());
    }
    function isAdmin() {
      return hasPerm('ADMIN');
    }

    // Feltöltési korlát: kép, józan mérethatárral. A korlát a szabályba
    // tartozik és nem a formba — a kliens SDK-t a form megkerülésével is meg
    // lehet hívni, a tárolás és a forgalom pedig a bucket tulajdonosának a
    // számláján van. A `delete` nem visz erőforrást magával, ezért az üres
    // `request.resource` átmegy.
    function isImageUpload(maxBytes) {
      return request.resource == null
          || (request.resource.size < maxBytes
              && request.resource.contentType.matches('image/.*'));
    }

    // Document entitás fájljai (document-form, export-import: `/document/{hash}`).
    // Publikus olvasás: a katalógusoldalak borítóit bárki letöltheti.
    //
    // Feltölteni csak képet lehet, legfeljebb 5 MB-ot: a kézzel feltöltött
    // borító és a visszaimportált kép is ezen belül van. A generált jelvényt
    // az Admin SDK teszi le (`badge-generation.ts`), arra a szabály nem
    // vonatkozik — ott a function őrzi a 8 MB-os határt.
    match /document/{path=**} {
      allow read: if true;
      allow create: if hasPerm('createDocumentEntity')
                    && isImageUpload(5 * 1024 * 1024);
      allow update: if (hasPerm('createDocumentEntity')
                        || hasPerm('updateDocumentEntity'))
                    && isImageUpload(5 * 1024 * 1024);
      allow delete: if hasPerm('deleteDocumentEntity');
    }

    // Katalógus bundle-ök (`tools/sync/build-bundles.mjs`, Admin SDK írja).
    // Publikus olvasás: a katalógus is az.
    match /bundles/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // Avatar-ruhatár: a profil karakterkészítőjének rajzolt rétegei
    // (`tools/avatar/upload-assets.mjs` tölti fel, Admin SDK-val). Publikus
    // olvasás: a kliens egy sima <img>-mel rajzolja őket, ami nem visz
    // Auth-tokent, és a katalógusképekhez hasonlóan nincs is mit védeni
    // rajtuk. A verziózott mappát (`avatar/v1/`) örökre cache-elhetőnek
    // adjuk ki, ezért nem felülírjuk, hanem új verziót töltünk fel.
    match /avatar/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // A gyűjtő összeállított avatarjának kirenderelt képe. Az útvonal viszi
    // a tulajdonost, így csak ő írhatja. Az olvasás publikus: az avatar ott
    // jelenik meg, ahol a gyűjtő mások mellett áll — a térképen, a hálózati
    // oldalon, a felső sávban.
    match /user-avatar/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isImageUpload(1 * 1024 * 1024);
    }

    // Példányfotók: a gyűjtő saját lemezéről készült kép, példányonként
    // legfeljebb kettő (elöl-hátul). Az útvonal viszi a tulajdonost, így a
    // jogosultság ránézésre eldönthető, és a Firestore-szabály ugyanerre az
    // alakra illeszti a dokumentumban tárolt `path`-t.
    //
    // Az olvasás a tulajdonosé: a példány-oldal ma csak a saját lemezeidet
    // nyitja meg. Ha később megosztható lesz, ez a sor nyílik publikusra —
    // a feltöltés akkor sem.
    match /collection-item/{userId}/{itemId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && hasPerm('updateCollectionItemEntity')
                   && isImageUpload(2 * 1024 * 1024);
    }

    // Minden más: csak ADMIN.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
