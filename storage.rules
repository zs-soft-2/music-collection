rules_version = '2';

// ---------------------------------------------------------------------------
// Music Collection — Cloud Storage security rules.
//
// Permission-alapú, a firestore.rules-szal azonos permission-nevekkel.
// Csak a token-claimet (`request.auth.token.permissions`) nézzük: a
// ttzs-ben a cross-service `firestore.get()` az effective_permissions
// dokumentumra prodon nem oldódott fel. Ezért a permission-szinkron
// functionnek a custom claimet is ki kell írnia, és a kliensnek a
// szinkron után frissítenie kell az ID tokent (getIdToken(true)).
// ---------------------------------------------------------------------------

service firebase.storage {
  match /b/{bucket}/o {

    function hasPerm(perm) {
      return request.auth != null
          && request.auth.token.permissions is list
          && (perm in request.auth.token.permissions
              || 'ADMIN' in request.auth.token.permissions);
    }
    function isAdmin() {
      return hasPerm('ADMIN');
    }

    // Document entitás fájljai (document-form, export-import: `/document/{hash}`).
    // Publikus olvasás: a katalógusoldalak borítóit bárki letöltheti.
    match /document/{path=**} {
      allow read: if true;
      allow create: if hasPerm('createDocumentEntity');
      allow update: if hasPerm('createDocumentEntity') || hasPerm('updateDocumentEntity');
      allow delete: if hasPerm('deleteDocumentEntity');
    }

    // Katalógus bundle-ök (`tools/sync/build-bundles.mjs`, Admin SDK írja).
    // Publikus olvasás: a katalógus is az.
    match /bundles/{path=**} {
      allow read: if true;
      allow write: if false;
    }

    // Tenant-szintű fájlok (pl. példányfotók) később ide kerülnek:
    // `tenant/{tenantId}/…` — tulajdonlás-ellenőrzéssel. Addig tiltva.

    // Minden más: csak ADMIN.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
